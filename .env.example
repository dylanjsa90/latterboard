# Copy to app/.env.local for development (read while APP_ENV=local, the default), to
# app/.env on the production VM (read when APP_ENV=production, which the systemd unit
# sets), or to .env in the project root for `docker compose`. Real environment variables win.

# local | staging | production. Anything but local requires a real SECRET_KEY and skips
# seeding the first.user@test.com sign-in. It picks the env file, so a value here only
# matters to docker compose; elsewhere set it in the real environment.
APP_ENV=local
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database: sqlite (the default) or postgres.
DB_TYPE=sqlite
# Relative to the directory the app starts in; use an absolute path (four slashes) in
# production. The Docker image defaults to sqlite:////data/sql_app.db.
SQLITE_DATABASE_URL=sqlite:///./sql_app.db
# Used when DB_TYPE=postgres (connects with sslmode=require).
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

REDIS_URL=redis://localhost:6379

# Lowest level logged to stdout: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# webcade's origin, used in invite and password-reset links and allowed by CORS.
FRONTEND_HOST=http://localhost:5173
# Extra CORS origins, comma-separated.
BACKEND_CORS_ORIGINS=

# Google sign-in: the web client ID from Google Cloud (public; same as webcade's
# VITE_GOOGLE_CLIENT_ID). Empty turns it off.
GOOGLE_CLIENT_ID=

# Email (invite links, password recovery). Off unless SMTP_HOST and EMAILS_FROM_EMAIL are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# Only for the optional local Postgres container (docker compose --profile local-db).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=latterboard

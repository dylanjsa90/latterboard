<mjml>
  <mj-body background-color="#eef0f4">
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column vertical-align="middle" width="100%">
        <mj-text align="left" padding="0 25px 8px" font-size="14px" font-family="Arial, Helvetica, sans-serif" color="#5f6380">{{ project_name }}</mj-text>
        <mj-text align="left" padding="0 25px 20px" font-size="24px" font-weight="bold" font-family="Arial, Helvetica, sans-serif" color="#191b3a">{{ inviter_username }} invited you to play {{ game_title }}</mj-text>
        {% if message %}
        <mj-text align="left" padding="0 25px 20px" font-size="18px" line-height="1.5" font-family="Arial, Helvetica, sans-serif" color="#191b3a" css-class="message">&ldquo;{{ message }}&rdquo;</mj-text>
        {% endif %}
        <mj-button align="left" font-size="16px" font-weight="bold" background-color="#ffbe1a" border-radius="6px" color="#191b3a" href="{{ link }}" padding="10px 25px 20px">Play {{ inviter_username }}</mj-button>
        <mj-text align="left" padding="0 25px" font-size="14px" line-height="1.5" font-family="Arial, Helvetica, sans-serif" color="#5f6380">Sign in or create a free account to start the match. This invite works once and expires on {{ expires_on }}.</mj-text>
        <mj-text align="left" padding="12px 25px 0" font-size="12px" font-family="Arial, Helvetica, sans-serif" color="#5f6380">If the button doesn't work, open this link: {{ link }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

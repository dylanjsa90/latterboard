# Python and tooling
.venv/
__pycache__/
*.py[co]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local state: env files, databases, logs
.env
.env.*
!.env.example
**/.env
**/.env.*
*.db
*.db-journal
# WAL mode's companions. Never upload these: one unpacked over the VM's live database
# would be replayed onto it.
*.db-wal
*.db-shm
logs/
*.log

# Editors and agents
.vscode/
.claude/
.worktrees/
.DS_Store
